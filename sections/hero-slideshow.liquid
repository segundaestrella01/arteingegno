

{% liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  case section.settings.section_height
    when 'full-screen'
      assign min_height = '100svh'
    when 'large'
      assign min_height = 'var(--section-height-large)'
    when 'medium'
      assign min_height = 'var(--section-height-medium)'
    when 'small'
      assign min_height = 'var(--section-height-small)'
    else
      assign min_height = 'var(--section-height-large)'
  endcase
%}

<hero-slideshow-component
  id="HeroSlideshow-{{ section.id }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  data-transition-duration="800"
>
  <div
    class="hero-slideshow color-{{ section.settings.color_scheme }}"
    style="--hero-slideshow-min-height: {{ min_height }};"
  >
    <div class="hero-slideshow__track">
      {% for block in section.blocks %}
        <div
          class="hero-slideshow__slide{% if forloop.first %} is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        >
          <div class="hero-slideshow__media-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag:
                  class: 'hero-slideshow__media',
                  width: block.settings.image.width,
                  height: block.settings.image.height,
                  widths: '832, 1200, 1600, 1920, 2560, 3840',
                  sizes: '100vw',
                  fetchpriority: fetch_priority,
                  alt: block.settings.image.alt | default: block.settings.heading | default: ''
              }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-slideshow__media' }}
            {% endif %}

            {% if section.settings.toggle_overlay %}
              <div
                class="hero-slideshow__overlay"
                style="
                  {% if section.settings.overlay_style == 'gradient' %}
                    background: linear-gradient({{ section.settings.gradient_direction }}, {{ section.settings.overlay_color }}, transparent);
                  {% else %}
                    background: {{ section.settings.overlay_color }};
                  {% endif %}
                "
              ></div>
            {% endif %}
          </div>

          <div class="hero-slideshow__content-wrapper page-width">
            <div class="hero-slideshow__content">
              {% if block.settings.heading != blank %}
                <p class="hero-slideshow__heading">{{ block.settings.heading }}</p>
              {% endif %}
              {% if block.settings.subheading != blank %}
                <p class="hero-slideshow__subheading">{{ block.settings.subheading }}</p>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <a
                  href="{{ block.settings.button_link | default: '#' }}"
                  class="button button-secondary hero-slideshow__cta"
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}

      {% if section.blocks.size == 0 %}
        <div class="hero-slideshow__slide is-active">
          <div class="hero-slideshow__media-wrapper">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-slideshow__media' }}
          </div>
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="hero-slideshow__nav" role="tablist" aria-label="Slideshow navigation">
        {% for block in section.blocks %}
          <button
            class="hero-slideshow__dot{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="{{ forloop.index }} / {{ section.blocks.size }}"
            data-index="{{ forloop.index0 }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</hero-slideshow-component>

{% stylesheet %}
  .hero-slideshow-wrapper {
    --hero-height-offset: 0px;
  }

  body:has(> #header-group > .header-section > #header-component) .hero-slideshow-wrapper:first-child {
    --hero-height-offset: var(--header-group-height, 0);
  }

  hero-slideshow-component {
    display: block;
  }

  .hero-slideshow {
    position: relative;
    min-height: calc(var(--hero-slideshow-min-height) - var(--hero-height-offset));
    overflow: hidden;
  }

  .hero-slideshow__track {
    position: absolute;
    inset: 0;
  }

  .hero-slideshow__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slideshow__slide {
      transition: none;
    }
  }

  .hero-slideshow__slide.is-active {
    opacity: 1;
    pointer-events: all;
    z-index: 1;
  }

  .hero-slideshow__media-wrapper {
    position: absolute;
    inset: 0;
  }

  .hero-slideshow__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .hero-slideshow__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-slideshow__content-wrapper {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-block-end: 72px;
    padding-block-start: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .hero-slideshow__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    width: 100%;
    pointer-events: all;
  }

  .hero-slideshow__heading {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
    margin: 0;
    line-height: 1.1;
    text-wrap: pretty;
  }

  .hero-slideshow__subheading {
    font-family: var(--font-jost, 'Jost', sans-serif);
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    margin: 0;
  }

  .hero-slideshow__cta {
    margin-block-start: 8px;
  }

  .hero-slideshow__nav {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .hero-slideshow__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    cursor: pointer;
    padding: 0;
    opacity: 0.4;
    transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .hero-slideshow__dot.is-active {
    background: currentColor;
    opacity: 1;
    transform: scale(1.3);
  }

  .hero-slideshow__dot:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .hero-slideshow__content-wrapper {
      padding-block-end: 56px;
    }

    .hero-slideshow__heading {
      font-size: clamp(1.6rem, 8vw, 2.5rem);
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('hero-slideshow-component')) {
    class HeroSlideshow extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.hero-slideshow__slide'));
        this.dots = Array.from(this.querySelectorAll('.hero-slideshow__dot'));
        this.currentIndex = 0;
        this.speed = parseInt(this.dataset.autoplaySpeed) || 5000;
        this.transitionDuration = parseInt(this.dataset.transitionDuration) || 800;
        this.timer = null;
        this.isTransitioning = false;

        this.dots.forEach((dot, i) => {
          dot.addEventListener('click', () => {
            if (i === this.currentIndex) return;
            this.goTo(i);
            this.restart();
          });
        });

        if (this.slides.length > 1) {
          this.start();

          this.addEventListener('mouseenter', () => this.stop(), { passive: true });
          this.addEventListener('mouseleave', () => this.start(), { passive: true });
          this.addEventListener('touchstart', () => this.stop(), { passive: true });
          this.addEventListener('touchend', () => this.start(), { passive: true });
        }
      }

      disconnectedCallback() {
        this.stop();
      }

      goTo(index) {
        if (this.isTransitioning) return;
        this.isTransitioning = true;

        const prev = this.currentIndex;
        this.currentIndex = index;

        this.slides[prev].classList.remove('is-active');
        this.slides[prev].setAttribute('aria-hidden', 'true');
        this.slides[index].classList.add('is-active');
        this.slides[index].removeAttribute('aria-hidden');

        this.dots[prev]?.classList.remove('is-active');
        this.dots[prev]?.setAttribute('aria-selected', 'false');
        this.dots[index]?.classList.add('is-active');
        this.dots[index]?.setAttribute('aria-selected', 'true');

        setTimeout(() => {
          this.isTransitioning = false;
        }, this.transitionDuration);
      }

      next() {
        this.goTo((this.currentIndex + 1) % this.slides.length);
      }

      start() {
        this.stop();
        this.timer = setInterval(() => this.next(), this.speed);
      }

      stop() {
        clearInterval(this.timer);
        this.timer = null;
      }

      restart() {
        this.start();
      }
    }

    customElements.define('hero-slideshow-component', HeroSlideshow);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Hero Slideshow",
  "tag": "section",
  "class": "hero-slideshow-wrapper section-wrapper",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Where Every Detail Has A Story"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Handcrafted jewellery with selected materials."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide duration (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full-screen", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "alpha": true,
      "default": "#12121266"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction",
      "options": [
        { "value": "to top", "label": "Up" },
        { "value": "to bottom", "label": "Down" }
      ],
      "default": "to top"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "category": "Banners",
      "blocks": {
        "slide_1": {
          "type": "slide",
          "settings": {
            "heading": "Where Every Detail Has A Story",
            "subheading": "Handcrafted jewellery with selected materials.",
            "button_label": "Shop Now",
            "button_link": "shopify://collections/all"
          }
        }
      },
      "block_order": ["slide_1"],
      "settings": {
        "section_height": "large",
        "color_scheme": "scheme-6",
        "toggle_overlay": true,
        "overlay_color": "#12121266",
        "overlay_style": "solid",
        "autoplay_speed": 5
      }
    }
  ]
}
{% endschema %}
